# Copia este archivo a .env.dev para el desarrollo local.
# Entorno disponible: dev, test o prod.
APP_ENV=dev
APP_DEBUG=false

# Credenciales locales de PostgreSQL definidas en compose.yaml.
APP_DATABASE_URL=postgresql+asyncpg://prodato:prodato@127.0.0.1:5432/prodato_dev

# Lista de orígenes en formato JSON.
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
